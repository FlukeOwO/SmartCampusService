# =============================================================================
# Smart Campus Service Platform - Local development (.env)
# คัดลอกเป็น .env แล้วแก้ค่า - ไฟล์ .env ห้าม commit
# บน Cloud Run ค่าพวกนี้ตั้งด้วย infra/gcp/setup.sh และค่าลับมาจาก Secret Manager
# =============================================================================

# Application
ENVIRONMENT=development
DEBUG=true
# ENABLE_DOCS=true            # ไม่ตั้ง = เปิด Swagger ทุก env ยกเว้น production

# Security / JWT  (สร้าง key: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-local-dev-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT=5/minute

# Database (docker compose: host = db)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=campus_admin
POSTGRES_PASSWORD=campus_secure_password_2024
POSTGRES_DB=smart_campus
DB_SSL=disable                # Cloud SQL ใช้ require
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=10          # วินาที แล้วตอบ 503 ให้ client ลองใหม่ (ไม่ค้าง 30 วินาที)

# HTTP
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=*

# Storage: local (dev) | gcs (cloud)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=8
MAX_FILES_PER_REQUEST=3
MAX_UPLOAD_TOTAL_MB=24      # ต้องต่ำกว่า 32 MiB ของ Cloud Run
GCS_BUCKET_NAME=
GCS_PROJECT_ID=
SIGNED_URL_EXPIRE_MINUTES=15

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Seed (python seed.py)
SEED_DEMO_DATA=true
# SEED_ADMIN_EMAIL=admin@smartcampus.dev
# SEED_ADMIN_PASSWORD=choose-a-strong-password

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Smart Campus Service"
