# =============================================================================
# Smart Campus Service Platform - Environment Configuration
# =============================================================================
# คัดลอกไฟล์นี้เป็น .env และปรับแต่งค่าตามต้องการ
# สำหรับ Production บน GCP ให้เปลี่ยน STORAGE_PROVIDER=gcs และตั้งค่า GCS_BUCKET_NAME

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME="Smart Campus Service Platform"
API_VERSION=v1

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true

# CORS Origins (คั่นด้วย comma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# -----------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# -----------------------------------------------------------------------------
# สำหรับ Local Development (Docker Compose)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=campus_admin
POSTGRES_PASSWORD=campus_secure_password_2024
POSTGRES_DB=smart_campus

# Database URL (Auto-generated จาก config.py)
# postgresql+asyncpg://campus_admin:campus_secure_password_2024@db:5432/smart_campus

# สำหรับ Production (Cloud SQL)
# POSTGRES_SERVER=<Cloud-SQL-Private-IP>
# POSTGRES_PORT=5432
# หรือใช้ Cloud SQL Proxy: /cloudsql/<PROJECT>:<REGION>:<INSTANCE>

# -----------------------------------------------------------------------------
# Security & Authentication
# -----------------------------------------------------------------------------
# JWT Secret Key (ต้องสร้างใหม่สำหรับ Production!)
# สร้างด้วย: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Storage Configuration (File Upload)
# -----------------------------------------------------------------------------
# STORAGE_PROVIDER: "local" สำหรับ Localhost, "gcs" สำหรับ Google Cloud Storage
STORAGE_PROVIDER=local

# Local Storage (Docker Volume)
LOCAL_STORAGE_PATH=/app/storage
MAX_UPLOAD_SIZE_MB=10

# Google Cloud Storage (ใช้เมื่อ STORAGE_PROVIDER=gcs)
GCS_BUCKET_NAME=smart-campus-uploads
GCS_PROJECT_ID=your-gcp-project-id
# GCS Credentials: ใช้ Service Account Key หรือ Workload Identity บน Cloud Run
# GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcs-service-account.json

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Smart Campus Service"

# -----------------------------------------------------------------------------
# Logging & Monitoring
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
# สำหรับ Production ใช้ JSON structured logging
LOG_FORMAT=json

# Cloud Logging (GCP)
ENABLE_CLOUD_LOGGING=false
GCP_PROJECT_ID=your-gcp-project-id

# -----------------------------------------------------------------------------
# Rate Limiting & Security Headers
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
ENABLE_SECURITY_HEADERS=true

# -----------------------------------------------------------------------------
# Email/Notification (ถ้ามีในอนาคต)
# -----------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password

# -----------------------------------------------------------------------------
# Redis (สำหรับ Caching/Session - Optional)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://redis:6379/0
